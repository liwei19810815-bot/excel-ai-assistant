@echo off
chcp 65001 >nul
setlocal

REM ============================================================
REM  这个脚本已作废，故意不再执行任何安装动作。
REM
REM  作废原因有两条，都是硬伤：
REM
REM  1) 它会用 certutil 把内网自签 CA 装进当前用户的受信任根存储。
REM     那是降低用户整台机器防护等级的操作——那个根证书能为【任意域】
REM     签发被这台机器信任的证书，影响远不止这一个加载项。
REM     现在的前提是：网关用【已被客户端信任】的证书
REM     （域内 PKI 下发或公网证书），谁都不用装证书。
REM
REM  2) 它注册的是一个【共享目录里的公共 manifest】，
REM     里面没有 ?u=<用户名>。而白名单分流完全依赖那个参数——
REM     用它装出来的客户端，所有人都会落到"自己配模型"，
REM     IT 配好的模型对谁都不生效，而且【不会报任何错】。
REM
REM  正确做法：用 Excel 工具箱的一键安装包。
REM  它会按当前用户名生成专属 manifest 并完成注册。
REM      Excel Macro 仓库 → build\pack.ps1 -Gateway "https://你的网关"
REM      详见 Excel Macro\docs\打包指南.md
REM ============================================================

echo.
echo   这个安装脚本已作废，不会执行任何操作。
echo   ============================================
echo.
echo   请改用 Excel 工具箱的一键安装包：
echo     解压后双击「Excel工具箱.bat」，按提示选择安装 AI 助手。
echo.
echo   原因（简述）：
echo     1. 旧脚本会往你的系统里安装根证书，现在不需要也不应该这么做
echo     2. 旧脚本注册的清单里没有用户身份，白名单分流会整个失效
echo        （而且不会报错，只是所有人都要自己配模型）
echo.
echo   详见 Excel Macro\docs\AI接入与白名单.md
echo.
pause
exit /b 1
