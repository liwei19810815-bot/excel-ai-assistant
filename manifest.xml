<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!--
    设计原则：manifest 尽量写得通用，权限一次给足、Ribbon 按钮预留，
    让日后的功能迭代都发生在前端代码里 —— 前端从 URL 实时加载，用户无感更新。
    详见 docs/DEPLOY.md。
    发布前请替换 Id（新 GUID）、ProviderName、以及所有 https://localhost:3000 为线上地址。
  -->
  <Id>8f3c1d7a-9e42-4b6f-a1c8-2d5e7b90f413</Id>
  <!-- Office 要求 ≥ 1.0.0.0。与 package.json 的版本相互独立，
       仅在 manifest 本身变化（增删按钮、改地址）时才需要递增。 -->
  <Version>1.0.0.0</Version>
  <ProviderName>Excel AI Assistant</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="Excel AI 助手"/>
  <Description DefaultValue="在任务窗格中与可自配置的大模型对话，让 AI 直接读写、格式化、分析你的工作簿。"/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
    <Host Name="Presentation"/>
    <Host Name="Document"/>
  </Hosts>

  <!-- 不声明顶层 Requirements/Sets：Excel 和 PowerPoint 各自的 API 集
       互不包含，写死任何一个都会挡住另一边装不上（Codex 验收发现的
       阻塞问题）。曾经尝试把要求分别放进 VersionOverrides 里各个
       Host 块自己的 Requirements 里，但 office-addin-manifest validate
       报错：Host 的合法子元素只有 Runtimes/AllFormFactors/
       DesktopFormFactor，不允许 Requirements（这也是 Codex 复审时
       用真实校验工具跑出来发现的）。所以两边都不做 manifest 层的版本
       门槛，完全依赖运行时 isSetSupported/requireApi 探测降级
       （src/excel/coordinator.ts、src/powerpoint/coordinator.ts 已有）-->

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/src/taskpane/index.html"/>
  </DefaultSettings>

  <!-- ReadWriteDocument：读写单元格、格式、图表所必需 -->
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ExcelAI.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <!-- 主按钮：打开 AI 对话任务窗格 -->
                <Control xsi:type="Button" id="ExcelAI.OpenPane">
                  <Label resid="OpenPane.Label"/>
                  <Supertip>
                    <Title resid="OpenPane.Label"/>
                    <Description resid="OpenPane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ExcelAI.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

                <!-- 预留按钮：对当前选区发起提问。功能变化留在前端，避免日后改 manifest -->
                <Control xsi:type="Button" id="ExcelAI.AskSelection">
                  <Label resid="AskSelection.Label"/>
                  <Supertip>
                    <Title resid="AskSelection.Label"/>
                    <Description resid="AskSelection.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>askAboutSelection</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <!-- PPT AI：同一个任务窗格 bundle，运行时按 Office.context.host 分支
           工具列表（见 src/store/host.ts）。只留"AI 对话"这一个入口——
           "问选区"在 PPT 里对应的是选中的形状/文字，和 Excel 的区域选区
           不是一回事，值得单独设计，这一轮先不做。 -->
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="PptGetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="PptAI.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="PptAI.OpenPane">
                  <Label resid="OpenPane.Label"/>
                  <Supertip>
                    <Title resid="OpenPane.Label"/>
                    <Description resid="PptOpenPane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PptAI.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <!-- Word AI：同一个任务窗格 bundle，运行时按 Office.context.host
           分支工具列表（见 src/store/host.ts）。只留"AI 对话"这一个
           入口，和 PPT 那份一样不做"问选区"。 -->
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="WordGetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="WordAI.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="WordAI.OpenPane">
                  <Label resid="OpenPane.Label"/>
                  <Supertip>
                    <Title resid="OpenPane.Label"/>
                    <Description resid="WordOpenPane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WordAI.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/src/taskpane/index.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/src/commands/commands.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://localhost:3000/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="AI 助手"/>
        <bt:String id="OpenPane.Label" DefaultValue="AI 对话"/>
        <bt:String id="AskSelection.Label" DefaultValue="问选区"/>
        <bt:String id="GetStarted.Title" DefaultValue="Excel AI 助手已就绪"/>
        <bt:String id="PptGetStarted.Title" DefaultValue="PPT AI 助手已就绪"/>
        <bt:String id="WordGetStarted.Title" DefaultValue="Word AI 助手已就绪"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenPane.Tooltip" DefaultValue="打开对话面板，用自然语言让 AI 操作当前工作簿。"/>
        <bt:String id="AskSelection.Tooltip" DefaultValue="打开对话面板并带上当前选区，直接就选中的数据提问。"/>
        <bt:String id="PptOpenPane.Tooltip" DefaultValue="打开对话面板，用自然语言让 AI 操作当前演示文稿。"/>
        <bt:String id="WordOpenPane.Tooltip" DefaultValue="打开对话面板，用自然语言让 AI 操作当前文档。"/>
        <bt:String id="GetStarted.Description" DefaultValue="点击「开始」选项卡上的「AI 对话」按钮，先在设置页配置你的大模型，然后开始对话。"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
