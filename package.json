{
  "name": "excel-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Excel AI 助手 — 任务窗格对话式 AI，支持自配置大模型（BYOK）操作 Excel",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "build": "node scripts/gen-version.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs": "office-addin-dev-certs install",
    "check": "node scripts/check-consistency.mjs",
    "verify": "npm run typecheck && npm test && npm run check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/office-js": "^1.0.377",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-manifest": "^2.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
